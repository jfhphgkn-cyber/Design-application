import flet as ft

def main(page: ft.Page):
    page.title = "تطبيق تصاميم"
    page.vertical_alignment = ft.MainAxisAlignment.CENTER
    page.horizontal_alignment = ft.CrossAxisAlignment.CENTER
    page.theme_mode = ft.ThemeMode.DARK
    page.padding = 15

    # كود الإعلان الحقيقي الذي نسخته من AdMob تخليه هنا بين الأقواس
    MY_AD_UNIT_ID = "ca-app-pub-6998331739571776/4515770514"

    # بيانات التطبيق والدروس والاختبارات
    app_data = {
        "python": {
            "title": "🐍 تعليم لغة بايثون",
            "lesson": "الدرس الأول: أساسيات بايثون والطباعة\n\n- المتغيرات نخزن بها بيانات.\n- مثال: `name = 'Ali'`\n- لطباعة نص: `print('Hello')`\n\nهل فهمت هذا الدرس؟",
            "quiz": {
                "question": "سؤال: ما هي الدالة المستخدمة للطباعة في بايثون؟",
                "options": ["print()", "echo()", "write()"],
                "correct": 0
            }
        },
        "lua": {
            "title": "🌕 تعليم لغة Lua",
            "lesson": "الدرس الأول: أساسيات لغة لُัว\n\n- تستخدم لتعديل الألعاب والسكربتات.\n- مثال: `print('Hello Lua')`\n\nهل فهمت هذا الدرس؟",
            "quiz": {
                "question": "سؤال: كيف نكتب طباعة نص في لغة Lua؟",
                "options": ["console.log()", "print()", "printf()"],
                "correct": 1
            }
        },
        "pubg": {
            "title": "🛠️ تعليم صنع ملفات ببجي",
            "lesson": "الدرس الأول: مسارات وأنواع الملفات\n\n- ملفات التعديل تسمى `.pak` أو `.ini`.\n- توضع داخل مجلد اللعبة في `Android/data`.\n\nهل فهمت هذا الدرس؟",
            "quiz": {
                "question": "سؤال: ما هي صيغة ملفات التعديل الكبيرة في ببجي؟",
                "options": [".pak", ".txt", ".mp4"],
                "correct": 0
            }
        }
    }

    # بانر الإعلان (مرتبط بمعرفك الحقيقي)
    def ad_banner():
        return ft.Container(
            content=ft.Row([
                ft.Icon(ft.icons.AD_UNITS, color=ft.colors.AMBER, size=16),
                ft.Text(f" [إعلان AdMob] - ID ربط بنجاح", size=11, color=ft.colors.AMBER_ACCENT)
            ], alignment=ft.MainAxisAlignment.CENTER),
            bgcolor=ft.colors.GREY_900,
            padding=6,
            border_radius=6,
            margin=ft.margin.only(bottom=10)
        )

    # الواجهة الرئيسية (الخانات الثلاث)
    def go_home(e=None):
        page.clean()
        page.add(
            ft.Column([
                ad_banner(),
                ft.Text("🎨 تطبيق تصاميم", size=26, weight="bold", color="cyan"),
                ft.Text("اختر القسم التعليمي:", size=14, color="white70"),
                ft.Container(height=15),
                ft.ElevatedButton("🐍 تعليم لغة بايثون", on_click=lambda _: show_lesson("python"), width=280, height=50, style=ft.ButtonStyle(bgcolor=ft.colors.BLUE_900)),
                ft.Container(height=10),
                ft.ElevatedButton("🌕 تعليم لغة Lua", on_click=lambda _: show_lesson("lua"), width=280, height=50, style=ft.ButtonStyle(bgcolor=ft.colors.AMBER_900)),
                ft.Container(height=10),
                ft.ElevatedButton("🛠️ صنع ملفات ببجي", on_click=lambda _: show_lesson("pubg"), width=280, height=50, style=ft.ButtonStyle(bgcolor=ft.colors.DEEP_ORANGE_900)),
                ft.Container(height=20),
                ad_banner()
            ], alignment=ft.MainAxisAlignment.CENTER, horizontal_alignment=ft.CrossAxisAlignment.CENTER)
        )
        page.update()

    # عرض الدرس وخياري (فهمت / لم أفهم)
    def show_lesson(section_key):
        sec = app_data[section_key]
        page.clean()

        def on_understood(e):
            show_quiz(section_key)

        def on_not_understood(e):
            page.clean()
            page.add(
                ft.Column([
                    ad_banner(),
                    ft.Text("❌ لا تقلق، راجع الدرس بهدوء وسيتضح كل شيء", size=16, weight="bold", color="red"),
                    ft.Container(height=20),
                    ft.ElevatedButton("🔄 إعادة المحاولة", on_click=lambda _: show_lesson(section_key), width=200),
                    ft.Container(height=10),
                    ft.ElevatedButton("🏠 القائمة الرئيسية", on_click=go_home, width=200),
                    ad_banner()
                ], alignment=ft.MainAxisAlignment.CENTER, horizontal_alignment=ft.CrossAxisAlignment.CENTER)
            )
            page.update()

        page.add(
            ft.Column([
                ad_banner(),
                ft.Text(sec["title"], size=20, weight="bold", color="white"),
                ft.Divider(),
                ft.Container(
                    content=ft.Text(sec["lesson"], size=15),
                    padding=15,
                    bgcolor=ft.colors.GREY_900,
                    border_radius=10,
                    width=320
                ),
                ft.Container(height=20),
                ft.Row([
                    ft.ElevatedButton("✅ فهمت", on_click=on_understood, style=ft.ButtonStyle(bgcolor=ft.colors.GREEN_800)),
                    ft.ElevatedButton("❌ لم أفهم", on_click=on_not_understood, style=ft.ButtonStyle(bgcolor=ft.colors.RED_800))
                ], alignment=ft.MainAxisAlignment.CENTER),
                ft.Container(height=15),
                ft.ElevatedButton("⬅️ رجوع للقائمة", on_click=go_home, width=160),
                ad_banner()
            ], alignment=ft.MainAxisAlignment.CENTER, horizontal_alignment=ft.CrossAxisAlignment.CENTER)
        )
        page.update()

    # شاشة الاختبار (التي تظهر عند اختيار "فهمت")
    def show_quiz(section_key):
        quiz = app_data[section_key]["quiz"]
        page.clean()

        selected_ans = {"val": -1}
        result_msg = ft.Text("", size=15, weight="bold")

        def check_answer(e):
            if selected_ans["val"] == quiz["correct"]:
                result_msg.value = "🎉 إجابة صحيحة! بطل، استمر."
                result_msg.color = ft.colors.GREEN
            else:
                result_msg.value = "❌ إجابة خاطئة، حاول مرة أخرى."
                result_msg.color = ft.colors.RED
            page.update()

        def radio_changed(e):
            selected_ans["val"] = int(e.control.value)

        rg = ft.RadioGroup(content=ft.Column([
            ft.Radio(value="0", label=quiz["options"][0]),
            ft.Radio(value="1", label=quiz["options"][1]),
            ft.Radio(value="2", label=quiz["options"][2]),
        ]), on_change=radio_changed)

        page.add(
            ft.Column([
                ad_banner(),
                ft.Text("📝 اختبار قصير للدرس", size=20, weight="bold", color="cyan"),
                ft.Divider(),
                ft.Text(quiz["question"], size=15, weight="bold"),
                ft.Container(height=10),
                rg,
                ft.Container(height=15),
                ft.ElevatedButton("تحقق من الإجابة", on_click=check_answer, style=ft.ButtonStyle(bgcolor=ft.colors.BLUE_700)),
                result_msg,
                ft.Container(height=20),
                ft.Row([
                    ft.ElevatedButton("📚 درس آخر", on_click=lambda _: show_lesson(section_key), width=130),
                    ft.ElevatedButton("🏠 الرئيسية", on_click=go_home, width=130)
                ], alignment=ft.MainAxisAlignment.CENTER),
                ad_banner()
            ], alignment=ft.MainAxisAlignment.CENTER, horizontal_alignment=ft.CrossAxisAlignment.CENTER)
        )
        page.update()

    go_home()

ft.app(target=main)
